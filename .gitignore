# DuckDB database file (rebuilt from ingest)
market.duckdb
market.duckdb.wal

# dbt artifacts
target/
dbt_packages/
logs/
.user.yml

# Generated by scripts/triage/capture_failure.py on a failed run
failure_context.json

# Generated by scripts/triage/diagnose_failure.py; local secrets
diagnosis.json
.env

# Snowflake credentials. Keys belong in ~/.snowflake, never in the repo, but
# ignore them here too so an accidental copy cannot be committed.
.envrc
*.p8
*.pub
*.pem

# Generated by scripts/triage/propose_fix.py on a failed run
proposed_fix_issue.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store

# Agent scratch: session state and the throwaway worktrees agents check out
# into. Holds old copies of tracked files, so committing it would resurrect
# text that was deliberately edited out.
.claude/

# Lavish Editor review sessions (not part of the pipeline)
.lavish/
exports/

# Generated dashboard - published to Pages, never committed
site/

# Blocked drafts from the report agent's publication gate. Per-run evidence of
# a catch, not source. The published reports themselves are deliberately NOT
# ignored: those are the artifact the gate exists to produce.
reports/*-gate-failure.json
