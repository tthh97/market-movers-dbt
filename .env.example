# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# Used by scripts/diagnose_failure.py (session 2 of the assisted-triage layer).
# In CI, set this as a GitHub Actions secret instead - do not commit a real key.
ANTHROPIC_API_KEY=

# Optional: override the diagnosis model (defaults to claude-opus-4-8).
# DIAGNOSIS_MODEL=claude-opus-4-8
