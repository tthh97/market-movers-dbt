# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# Used by scripts/triage/diagnose_failure.py (session 2 of the assisted-triage layer).
# In CI, set this as a GitHub Actions secret instead - do not commit a real key.
ANTHROPIC_API_KEY=

# Optional: override the diagnosis model (defaults to claude-opus-4-8).
# DIAGNOSIS_MODEL=claude-opus-4-8


# ---------------------------------------------------------------------------
# Snowflake. Read by both profiles.yml and warehouse.py, so the loader and the
# models can never disagree about which warehouse they are pointed at.
# ---------------------------------------------------------------------------

# Which output in profiles.yml to use:
#   snowflake     key-pair auth (default, and what CI uses)
#   snowflake_pw  password auth, local exploration only
#   duckdb        offline demo, no credentials needed
# DBT_TARGET=snowflake

# From Snowsight, bottom-left account menu -> "Copy account identifier".
# Format is <orgname>-<account_name>.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=<your_user>

# Key-pair auth. Point at the .p8 private key; leave the passphrase blank if
# the key is unencrypted. Never move the key inside the repo.
SNOWFLAKE_PRIVATE_KEY_PATH=$HOME/.snowflake/dbt_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Only for DBT_TARGET=snowflake_pw.
# SNOWFLAKE_PASSWORD=

# All four are REQUIRED - there are no built-in defaults, so a typo fails loudly
# instead of silently connecting as the wrong role. Use the names you chose in
# snowflake-setup.md. Point the warehouse at the one your resource monitor is
# attached to; anything else runs outside the spend guardrail.
SNOWFLAKE_ROLE=<transformer_role>
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=<database>

# Use a personal dev schema here. CI overrides this with the prod schema, so
# keeping them different means a stray local `dbt build` cannot overwrite the
# prod marts.
SNOWFLAKE_SCHEMA=<your_dev_schema>
