# LangSmith - tracing, Studio, and the chat UI's API key.
# The Snowflake reader identity and ANTHROPIC_API_KEY are NOT here: they are
# read from ../agent/.env, shared with the chat agent rather than copied.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=market-movers-deep-agent
# Non-US region? Uncomment your endpoint:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# The repo's one engine switch, the same DBT_TARGET dbt and the loaders read:
# snowflake (read-only REPORTER, from ../agent/.env) or duckdb (offline,
# ../market.duckdb opened read_only).
DBT_TARGET=snowflake
DEEP_AGENT_MODEL=anthropic:claude-sonnet-5
