# Snowflake connection for the agent. All are REQUIRED - there are no built-in
# defaults, so a typo fails loudly instead of connecting to the wrong place.

# From Snowsight: account menu -> "Copy account identifier". Format <org>-<account>.
SNOWFLAKE_ACCOUNT=<org>-<account>

# A dedicated read-only SERVICE user. Do NOT point this at a human or admin
# account: this process runs model-authored SQL, so the credential should buy
# nothing beyond SELECT on the analytics schema.
SNOWFLAKE_USER=<service_user>
SNOWFLAKE_ROLE=<read_only_role>

# Key-pair auth. Unencrypted PKCS#8, chmod 600, kept outside the repo.
SNOWFLAKE_PRIVATE_KEY_PATH=$HOME/.snowflake/<agent_key>.p8

SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=<database>
SNOWFLAKE_SCHEMA=<analytics_schema>

# Any current Claude model id.
AGENT_MODEL=<model_id>

# Used by the agent loop.
ANTHROPIC_API_KEY=<your_key>
